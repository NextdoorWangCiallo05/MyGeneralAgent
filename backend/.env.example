# ===== 基础设施 / 服务配置 =====
# 监听端口（uvicorn 启动参数，此处仅作记录）
APP_NAME=Agent App API

# DeepSeek（OpenAI 兼容协议）。M1 从环境变量读取；M2 起改为管理员后台配置并加密入库
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-flash
# 思考模式使用的推理模型：留空表示用厂商预设（DeepSeek 默认 deepseek-reasoner）；
# 私有部署（vLLM / 企业网关）在这里点名，如 THINKING_MODEL=QwQ-32B
THINKING_MODEL=
LLM_TIMEOUT=60
MAX_STEPS=10
TOOL_TIMEOUT=30

# ===== M3：工具沙箱（文件 / 代码类工具的隔离执行环境） =====
# 沙箱总闸：管理员可在后台覆盖。默认关闭（fail-closed）——
# 需先全局开启，用户在会话中打开沙箱后，文件 / 代码类工具才可用
SANDBOX_GLOBAL_ENABLED=false
# 沙箱根目录，每个用户一个子目录；相对路径以进程工作目录为基准
SANDBOX_ROOT=.sandbox
# 沙箱内子进程的执行超时（秒）、虚拟内存上限（MB，0 表示不限制）
SANDBOX_EXEC_TIMEOUT=10
SANDBOX_MEMORY_MB=256
# 子进程单路输出上限 / 单文件读写上限（字节）
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_MAX_FILE_BYTES=262144

# ===== M4：上下文压缩（FR-6）=====
# 送入模型的历史 token 估算值超过该阈值时，较早轮次会被摘要成一段文字（app/core/summary.py）
SUMMARY_TRIGGER_TOKENS=6000
# 压缩时保留最近多少轮完整对话（一轮 = 一条用户消息及其后续消息）
SUMMARY_KEEP_TURNS=6
# 新增待摘要内容不足该 token 数时先不调用模型，避免每轮都产生摘要开销
SUMMARY_MIN_NEW_TOKENS=400

# ===== M4：知识库（RAG）=====
# 单个文档大小上限（字节）与允许上传的扩展名
KNOWLEDGE_MAX_FILE_BYTES=5242880
KNOWLEDGE_ALLOWED_TYPES=txt,md,markdown,pdf
# 文本分块目标长度与相邻块重叠长度（字符），见 app/core/chunking.py
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=100

# ===== 对话附件（聊天输入框随消息上传的文件，见 app/api/attachments.py）=====
# 单个附件大小上限（字节）与允许上传的扩展名（解析复用知识库文档解析器）
ATTACHMENT_MAX_FILE_BYTES=5242880
ATTACHMENT_ALLOWED_TYPES=txt,md,markdown,log,csv,json,pdf
# 单条消息最多携带的附件数量
ATTACHMENT_MAX_PER_MESSAGE=5
# 单个附件注入模型上下文的最大字符数，超出部分截断（正文仍完整保留，可查看原文）。
# 注意：10 万汉字 ≈ 6~10 万 token，单个附件就可能超出多数模型的上下文窗口，
# 携带超大附件时建议把 ATTACHMENT_MAX_PER_MESSAGE 调小（如 1~2），或改用知识库检索。
ATTACHMENT_MAX_CHARS=100000
# 整个会话的附件注入总预算（字符）。附件是会话级资源，每轮都会重新注入，
# 因此需要总预算兜底：新文件优先整体展开，放不下的只列清单，模型用 read_attachment 按需读取。
ATTACHMENT_CONTEXT_MAX_CHARS=100000
# 上传后始终没随消息发出的附件，超过该时长由上传路径顺带清理（秒）
ATTACHMENT_TTL_SECONDS=86400

# ===== 技能（见 app/skills/）=====
# 自定义技能目录：每个 *.md 一个技能，文件名即技能 id，正文为指令，
# 头部可用 frontmatter 声明 name / description / tools（如 tools: read_file, write_file）。
# 留空则只用内置技能（research / coding / writing）；改完文件需重启服务。
SKILLS_DIR=

# ===== M4：向量化与检索（见 app/core/embedding.py、app/core/retriever.py）=====
# 嵌入后端：
#   hash  —— 字符 n-gram 哈希向量，零依赖（默认，无 GPU / 无 torch 也能跑通全链路，但无语义泛化）
#   local —— sentence-transformers 本地模型（需 pip install -r requirements-ml.txt，首次会下载模型）
#   none  —— 关闭向量化：知识库只存不检索，knowledge_search 不下发给模型
EMBEDDING_BACKEND=hash
# local 模式使用的模型（默认中文小模型，CPU 可跑）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 向量维度：hash 模式为哈希空间大小；local 模式以模型实际输出为准。
# PostgreSQL + pgvector 下该值决定列类型 vector(N)，切换维度需迁移列并重建索引
EMBEDDING_DIM=512
# 单进程内同时执行的向量化任务上限（本地模型推理吃 CPU，过高只会互相抢占）
EMBEDDING_MAX_CONCURRENCY=4
# 检索：默认 / 最大返回片段数
KNOWLEDGE_SEARCH_TOP_K=5
KNOWLEDGE_SEARCH_TOP_K_MAX=20
# 单次检索最多参与打分的文本块数：仅 MySQL / SQLite 生效（应用层打分）；
# PostgreSQL + pgvector 由数据库 top-k（HNSW 索引）完成，不受此上限约束
KNOWLEDGE_SEARCH_MAX_CHUNKS=2000
KNOWLEDGE_SEARCH_MIN_SCORE=0.05

# ===== M3：联网工具与人工确认 =====
HTTP_TIMEOUT=20
FETCH_MAX_BYTES=1048576
WEB_SEARCH_MAX_RESULTS=5
# 联网搜索后端（web_search）：auto / bing / duckduckgo / tavily / serper / brave / searxng
# auto（默认）按 Bing → DuckDuckGo 依次尝试免密钥后端，任一成功即返回；也可在管理后台切换与探测
SEARCH_PROVIDER=auto
# Tavily / Serper / Brave（或开启了鉴权的 SearXNG）的密钥；后台配置的密钥优先级更高且加密入库
SEARCH_API_KEY=
# 覆盖所选后端的预设地址；自建 SearXNG 必填（如 https://searx.example.com）
SEARCH_BASE_URL=
SEARCH_LOCALE=zh-CN
# 单个搜索后端的请求超时（秒）
SEARCH_TIMEOUT=12
# 需人工确认的工具等待用户操作的最长时间（秒），超时按拒绝处理
TOOL_CONFIRM_TIMEOUT=120

# ===== 存储 =====
# memory：进程内存储，重启即丢失（本地开发 / 跑测试，无需数据库）
# sql：MySQL 8+ 或 PostgreSQL 14+（SQLAlchemy 2.0 async + Alembic 迁移）
STORE_BACKEND=memory

# MySQL 异步连接串（STORE_BACKEND=sql 时必填）
# 字符集务必为 utf8mb4；需提前建库：CREATE DATABASE agent_app CHARACTER SET utf8mb4;
DATABASE_URL=mysql+aiomysql://agent:password@127.0.0.1:3306/agent_app?charset=utf8mb4
# PostgreSQL（推荐，配合 pgvector 做库内 top-k）：
# DATABASE_URL=postgresql+asyncpg://agent:password@127.0.0.1:5432/agent_app
# 建库后执行：CREATE EXTENSION IF NOT EXISTS vector;（或直接 alembic upgrade head）

DB_ECHO=false
# 连接池按「进程」计：总连接数 ≈ (DB_POOL_SIZE + DB_MAX_OVERFLOW) × worker 数，
# 需小于数据库 max_connections。uvicorn 多 worker 时相应调小
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
# 取连接的最长等待（秒）与「优先复用最近归还连接」（LIFO，空闲时更易回收多余连接）
DB_POOL_TIMEOUT=30
DB_POOL_USE_LIFO=true
# 启动时按 ORM 元数据自动建表（仅本地开发便利；生产请用 `alembic upgrade head`）
AUTO_CREATE_TABLES=false

# ===== 鉴权 =====
# 生产环境务必替换为随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 业务配置加密（system_config 中的 API-Key 等） =====
# 生产环境务必替换为随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 注意：更换该密钥会使库中既有密文无法解密，需在管理后台重新配置 API-Key
ENCRYPTION_KEY=dev-encryption-key-change-me
# 业务配置的进程内缓存时长（秒），0 表示每次都回源查库
RUNTIME_CONFIG_TTL=15

# 启动时自动创建的初始管理员（留空则不创建）
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ===== 找回密码 =====
RESET_TOKEN_EXPIRE_MINUTES=30
# 前端地址，用于拼接邮件中的重置链接
APP_BASE_URL=http://localhost:3000

# ===== 邮件 =====
# console：仅打印到后端日志（开发用）；smtp：真实发送
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_TLS=true

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000

# ===== M5：限流（进程内滑动窗口，无需 Redis；多实例部署需换共享存储）=====
# 总开关：关闭后所有限流判定直接放行（fail-open）
RATE_LIMIT_ENABLED=true
# 滑动窗口长度（秒），下列配额均指「每窗口」上限
RATE_LIMIT_WINDOW_SECONDS=60
# 分档配额：IP 兜底（防单机刷量）、认证接口（防撞库）、对话（防滥用模型）、上传（防刷存储）
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=20
# 是否信任反向代理透传的 X-Forwarded-For / X-Real-IP（仅在可信网关之后开启）
RATE_LIMIT_TRUST_PROXY=false

# ===== M5：可观测性（日志规范 + 链路追踪）=====
# 日志格式：text（本地可读，默认）/ json（生产采集，结构化字段见 app/core/logging.py）
LOG_FORMAT=text
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 是否把每个 Turn / Span 以结构化日志打印出来（无需外部依赖即可观测全链路）
OBSERVABILITY_LOG_SPANS=false
# Langfuse 追踪（可选，未配置时自动降级为 no-op；需 pip install langfuse）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
